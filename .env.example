# =========================================================================
# NEXT.JS ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to .env.local for local development, or add these
# keys in your hosting provider's dashboard (e.g., Vercel, Netlify).
# =========================================================================

# --- Supabase Database & Auth Config ---
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Server-only. Required on Vercel for abandoned-cart sessions and order writes.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- MyLead & Nutriprofits Affiliate Program Links ---
# Default links used if specific skin/goal offers are not configured
NEXT_PUBLIC_MYLEAD_LINK=https://mylead.global/ref/your-profile-id
NEXT_PUBLIC_NUTRIPROFITS_LINK=https://nutriprofits.com/ref/your-profile-id

# Targeted campaign offer links mapped from user diagnostic quiz selections
NEXT_PUBLIC_OFFER_ANTI_AGE=your-mylead-or-nutriprofits-anti-age-link
NEXT_PUBLIC_OFFER_ACNE_OILY=your-mylead-acne-campaign-link
NEXT_PUBLIC_OFFER_HYDRATION=your-mylead-or-nutriprofits-hydration-link

# --- Sanity Content Management System (CMS) ---
# Required for live sponsor banners. Without a real project ID the storefront
# falls back to the local Lancerto mock campaign.
NEXT_PUBLIC_SANITY_PROJECT_ID=your-sanity-project-id
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=your-sanity-write-or-read-token

# --- Klaviyo Email Marketing Integration ---
KLAVIYO_API_KEY=your-klaviyo-private-api-key
KLAVIYO_LIST_ID=your-klaviyo-newsletter-list-id

# --- Google OAuth Login ---
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# --- Public site URL (no trailing slash) ---
# Used for abandoned-cart recovery links and OAuth redirects.
NEXT_PUBLIC_SITE_URL=https://your-project.vercel.app

# --- Checkout recovery signing (required in production, min 16 chars) ---
CHECKOUT_RECOVERY_SECRET=replace-with-a-long-random-secret

# --- Payments ---
# Keep false until a licensed Polish/EU gateway is wired in code.
# Do not collect raw card numbers on this app.
NEXT_PUBLIC_PAYMENTS_ENABLED=false
# STRIPE_SECRET_KEY=
# PAYU_CLIENT_ID=
# PAYU_CLIENT_SECRET=
# P24_MERCHANT_ID=
# P24_CRC=
