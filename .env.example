# =========================================================================
# NEXT.JS ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to .env.local for local development, or add these
# keys in your hosting provider's dashboard (e.g., Vercel, Netlify).
# =========================================================================

# --- Supabase Database & Auth Config ---
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Server-only. Required on Vercel for abandoned-cart sessions and order writes.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- Nutriprofits Affiliate Links (nplink.net) ---
# Code defaults in src/lib/affiliateRouter.ts match these URLs so the live
# quiz/CTAs earn clicks even before Vercel env is set. Override any key to
# rotate a campaign without a deploy.
#
# Mapping:
#   NUTRIPROFITS_LINK  → unanswered quiz / primary CTA fallback
#   MYLEAD_LINK        → quiz skin-type fallback: mixed (mieszana)
#   OFFER_ANTI_AGE     → quiz goal: anti-age
#   OFFER_ACNE_OILY    → quiz goal: acne; oily skin (tlusta)
#   OFFER_HYDRATION    → quiz goal: hydration; dry skin (sucha)
NEXT_PUBLIC_NUTRIPROFITS_LINK=https://nplink.net/zj0o7ps8
NEXT_PUBLIC_MYLEAD_LINK=https://nplink.net/rsmetkhe
NEXT_PUBLIC_OFFER_ANTI_AGE=https://nplink.net/68rypowt
NEXT_PUBLIC_OFFER_ACNE_OILY=https://nplink.net/inmfcwwk
NEXT_PUBLIC_OFFER_HYDRATION=https://nplink.net/5py84cbz

# --- Sanity Content Management System (CMS) ---
# Required for live sponsor banners. Without a real project ID the storefront
# falls back to the local Lancerto mock campaign.
NEXT_PUBLIC_SANITY_PROJECT_ID=your-sanity-project-id
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=your-sanity-write-or-read-token

# --- Klaviyo Email Marketing Integration ---
KLAVIYO_API_KEY=your-klaviyo-private-api-key
KLAVIYO_LIST_ID=your-klaviyo-newsletter-list-id

# --- Google OAuth Login ---
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# --- Public site URL (no trailing slash) ---
# Used for abandoned-cart recovery links and OAuth redirects.
NEXT_PUBLIC_SITE_URL=https://polish-mcommerce.vercel.app

# --- Checkout recovery signing (required in production, min 16 chars) ---
CHECKOUT_RECOVERY_SECRET=replace-with-a-long-random-secret

# --- Payments ---
# Keep false until a licensed Polish/EU gateway is wired in code.
# Do not collect raw card numbers on this app.
NEXT_PUBLIC_PAYMENTS_ENABLED=false
# STRIPE_SECRET_KEY=
# PAYU_CLIENT_ID=
# PAYU_CLIENT_SECRET=
# P24_MERCHANT_ID=
# P24_CRC=
